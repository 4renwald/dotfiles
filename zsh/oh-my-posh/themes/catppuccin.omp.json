{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "os": "#ACB0BE",
    "pink": "#F5BDE6",
    "lavender": "#B7BDF8",
    "blue": "#8AADF4",
    "green": "#A6DA95",
    "yellow": "#EED49F",
    "peach": "#F5A97F",
    "teal": "#8BD5CA",
    "sky": "#91D7E3",
    "mauve": "#C6A0F6",
    "red": "#ED8796",
    "wight": "#FFFFFF",
    "text": "#494D64"
  },
  "blocks": [
    {
      "alignment": "left",
      "type": "prompt",
      "segments": [
        {
          "background": "p:blue",
          "foreground": "p:wight",
          "powerline_symbol": "",
          "leading_diamond": "",
          "style": "diamond",
          "template": "{{.Icon}} ",
          "type": "os"
        },
        {
          "background": "p:blue",
          "foreground": "p:text",
          "powerline_symbol": "",
          "style": "diamond",
          "template": "{{ .UserName }}@{{ .HostName }}",
          "type": "session"
        },
        {
          "background": "p:pink",
          "foreground": "p:text",
          "options": {
            "folder_icon": "....",
            "home_icon": "~",
            "style": "agnoster_short"
          },
          "powerline_symbol": "",
          "style": "powerline",
          "template": " {{ .Path }}",
          "type": "path"
        },
        {
          "background": "p:lavender",
          "foreground": "p:text",
          "style": "powerline",
          "options": {
            "branch_icon": " ",
            "cherry_pick_icon": " ",
            "commit_icon": " ",
            "fetch_status": false,
            "fetch_upstream_icon": false,
            "merge_icon": " ",
            "no_commits_icon": " ",
            "rebase_icon": " ",
            "revert_icon": " ",
            "tag_icon": " "
          },
          "powerline_symbol": "",
          "template": " {{ .HEAD }}",
          "type": "git"
        },
        {
          "background": "p:green",
          "foreground": "p:text",
          "style": "powerline",
          "powerline_symbol": "",
          "type": "python",
          "options": {
            "display_mode": "context",
            "fetch_virtual_env": true,
            "fetch_version": true,
            "folder_name_fallback": true,
            "home_enabled": false
          },
          "template": "  {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}"
        },
        {
          "background": "p:teal",
          "foreground": "p:text",
          "style": "powerline",
          "powerline_symbol": "",
          "type": "go",
          "options": {
            "display_mode": "context",
            "fetch_version": true,
            "parse_mod_file": true,
            "home_enabled": false
          },
          "template": "  {{ .Full }}"
        },
        {
          "background": "p:yellow",
          "foreground": "p:text",
          "style": "powerline",
          "powerline_symbol": "",
          "type": "node",
          "options": {
            "display_mode": "context",
            "fetch_version": true,
            "fetch_package_manager": true,
            "home_enabled": false
          },
          "template": "  {{ .Full }}{{ if .PackageManagerIcon }} {{ .PackageManagerIcon }}{{ end }}"
        },
        {
          "background": "p:peach",
          "foreground": "p:text",
          "style": "powerline",
          "powerline_symbol": "",
          "type": "rust",
          "options": {
            "display_mode": "context",
            "fetch_version": true,
            "home_enabled": false
          },
          "template": "  {{ .Full }}"
        }
      ]
    },
    {
      "alignment": "right",
      "type": "prompt",
      "overflow": "hide",
      "segments": [
        {
          "background": "p:mauve",
          "foreground": "p:text",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "type": "executiontime",
          "options": {
            "always_enabled": false,
            "threshold": 500,
            "style": "austin"
          },
          "template": "  {{ .FormattedMs }} "
        },
        {
          "background": "p:sky",
          "foreground": "p:text",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "type": "time",
          "options": {
            "time_format": "2006-01-02 15:04:05"
          },
          "template": "  {{ .CurrentDate | date .Format }} "
        }
      ]
    },
    {
      "alignment": "left",
      "type": "prompt",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "template": "\u276f"
        }
      ]
    }
  ],
  "final_space": true,
  "version": 4
}
